{
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run health)",
      "Bash(npm run db:backup)",
      "Bash(npm ci)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(node -v)",
      "Bash(psql --version)"
    ],
    "deny": [
      "Read(.env.local)",
      "Read(.env)",
      "Bash(npm audit fix --force)"
    ]
  }
}
