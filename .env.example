# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919217239733

# ─── Secrets ────────────────────────────────────────────
# Signs invoice download links and admin session cookies.
# REQUIRED in production — the app refuses to boot without it.
# Generate one with: openssl rand -hex 32
APP_SECRET=

# ─── Admin gate ─────────────────────────────────────────
# Preferred: store only a hash. Generate with `npm run admin:hash -- 'your password'`
ADMIN_PASSWORD_HASH=
# Fallback if you'd rather set the plaintext (ADMIN_PASSWORD_HASH wins if both set).
# If neither is set, a built-in default is used — fine for local dev, not for production.
ADMIN_PASSWORD=

# ─── Supabase (durable storage) ─────────────────────────
# Until these are set, orders and admin changes go to an append-only file that
# does NOT survive a redeploy on serverless hosts. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the file journal is written when Supabase is not configured.
# Defaults to ./.data locally, /tmp/horology365-data on Vercel.
DATA_DIR=

# ─── Razorpay / UPI (payments enabled later) ────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# UPI VPA shown at checkout for direct UPI-collect / QR (live now)
NEXT_PUBLIC_UPI_VPA=horology365@upi
NEXT_PUBLIC_UPI_PAYEE_NAME=Horology365

# ─── Payment mode ───────────────────────────────────────
# upi = UPI only (current). cod = Cash on Delivery. both = COD + UPI.
NEXT_PUBLIC_PAYMENT_MODE=upi

# ─── Analytics (env-gated) ──────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Order email (Resend) ───────────────────────────────
# Without RESEND_API_KEY no email is sent and the order response says so.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
ORDER_FROM_EMAIL=orders@horology365.com
# Store inbox that receives a copy of every order PDF. Defaults to ORDER_FROM_EMAIL.
ORDER_NOTIFY_EMAIL=

# ─── Order WhatsApp (Meta WhatsApp Cloud API) ───────────
# Both required for automatic sending. Without them the site falls back to a
# prefilled wa.me link that you tap to forward the invoice by hand.
#   1. developers.facebook.com -> your app -> WhatsApp -> API Setup
#   2. WHATSAPP_PHONE_ID is the "Phone number ID" (not the phone number)
#   3. WHATSAPP_TOKEN should be a permanent System User token, not the 24h test one
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

# Meta only allows free-form messages within 24h of the customer messaging you.
# For first-time buyers you need an approved template. Create one with two body
# variables ({{1}} = customer name, {{2}} = order id) and name it here.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Store WhatsApp number (digits + country code) that receives a copy of every
# order PDF. Defaults to NEXT_PUBLIC_WHATSAPP_NUMBER.
ORDER_NOTIFY_WHATSAPP=
