{
  "name": "horology365",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed-db.ts",
    "test": "tsx --tsconfig tsconfig.test.json --test tests/maintenance-lock.test.ts tests/no-demo-in-production.test.ts tests/backup-store.test.ts tests/site-url.test.ts tests/image-shape.test.ts tests/data-safety.test.ts tests/catalogue.test.ts tests/blob-read.test.ts tests/invoice-link.test.ts tests/inventory-maths.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "setup:prod": "bash scripts/setup-production.sh",
    "db:backup": "tsx scripts/backup-db.ts",
    "health": "node -e \"const u=process.env.SITE||'https://www.horology365.com';fetch(u+'/api/health?deep=1').then(r=>r.json()).then(d=>{console.log('status:',d.status);for(const[k,v]of Object.entries(d.checks))console.log((v.ok?'  OK   ':'  TODO ')+k+': '+v.detail)}).catch(e=>{console.error('could not reach',u,'-',e.message);process.exit(1)})\"",
    "snapshot:from-backup": "tsx scripts/snapshot-from-backup.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "clsx": "2.1.1",
    "next": "15.5.19",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.3.0",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "dotenv": "^17.4.2",
    "eslint": "9.28.0",
    "eslint-config-next": "15.5.19",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.5",
    "typescript": "5.8.3"
  }
}
