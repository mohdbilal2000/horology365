# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ─── Supabase (Phase 2) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Razorpay / UPI (Phase 2 — payments enabled later) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Default UPI VPA used for direct UPI-collect / QR (enabled later)
NEXT_PUBLIC_UPI_VPA=
NEXT_PUBLIC_UPI_PAYEE_NAME=Horology365

# ─── Payment mode ───────────────────────────────────────
# cod = Cash on Delivery only (current). upi = UPI enabled. both = COD + UPI.
NEXT_PUBLIC_PAYMENT_MODE=cod

# ─── Analytics (env-gated) ──────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Email (Phase 2) ────────────────────────────────────
RESEND_API_KEY=
ORDER_FROM_EMAIL=orders@horology365.com
