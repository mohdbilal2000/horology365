# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ─── Admin gate ──────────────────────────────────────────
# Shared password for /admin and /api/admin/*. If unset, a built-in default
# is used; change this in production via your Vercel project settings.
ADMIN_PASSWORD=showroom2026

# ─── Product & order storage (Vercel Blob) ──────────────
# Products, orders and the admin audit trail live in Vercel Blob, not a
# database — Storage → Create → Blob in your Vercel project, then paste the
# token it generates. Without this the admin cannot save and orders aren't
# stored, but the storefront still serves its shipped catalogue snapshot.
# See DATABASE.md.
BLOB_READ_WRITE_TOKEN=

# ─── UPI (live now — free, no gateway required) ─────────
# The business's real UPI ID, shown as a QR + deep link at checkout.
NEXT_PUBLIC_UPI_VPA=8131882560@nyes
NEXT_PUBLIC_UPI_PAYEE_NAME=KIVIKALI Y SHOHE

# ─── Bank transfer (live now — free, no gateway required) ──
# NEFT/IMPS destination shown at checkout as a second manual payment option.
# Set NEXT_PUBLIC_BANK_TRANSFER_ENABLED=false to hide it.
NEXT_PUBLIC_BANK_TRANSFER_ENABLED=true
NEXT_PUBLIC_BANK_ACCOUNT_NAME=KIVIKALI Y SHOHE
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=3490101002557
NEXT_PUBLIC_BANK_IFSC=CNRB0003490

# ─── Razorpay (optional — inert until ALL of these are set) ──
# Real credit/debit card acceptance always carries a per-transaction fee
# (~2%) charged by Razorpay — there is no free way to process raw card
# numbers. Leave these blank to keep card payments hidden; only fill them
# in if you've decided that trade-off is worth it.
#
# Note: the bank account above is NOT read for card settlement — Razorpay
# collects card payments into its own account first, then pays out to
# whichever bank account you enter in the Razorpay dashboard during signup
# (their KYC step, not an env var here).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Payment mode ───────────────────────────────────────
# upi = UPI only (current). cod = Cash on Delivery. both = COD + UPI.
NEXT_PUBLIC_PAYMENT_MODE=upi

# ─── Analytics (env-gated) ──────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Email (Phase 2) ────────────────────────────────────
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
ORDER_FROM_EMAIL=orders@horology365.com
# Store inbox that receives a copy of every order PDF. Defaults to ORDER_FROM_EMAIL.
ORDER_NOTIFY_EMAIL=

# ─── Order WhatsApp (Meta WhatsApp Cloud API) ───────────
# Both required for automatic sending. Without them the site falls back to a
# prefilled wa.me link carrying a signed invoice URL, to forward by hand.
#   1. developers.facebook.com -> your app -> WhatsApp -> API Setup
#   2. WHATSAPP_PHONE_ID is the "Phone number ID", not the phone number
#   3. Use a permanent System User token, not the 24h test token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

# Meta only allows free-form messages within 24h of the customer messaging you.
# First-time buyers need an approved template: create one with two body
# variables ({{1}} = customer name, {{2}} = order id) and name it here.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Store WhatsApp number (digits + country code) that receives a copy of every
# order PDF. Defaults to NEXT_PUBLIC_WHATSAPP_NUMBER.
ORDER_NOTIFY_WHATSAPP=

# ─── Secrets ────────────────────────────────────────────
# Signs invoice download links, so a customer's address can't be reached by
# guessing order ids. REQUIRED in production — the app refuses to sign without
# it. Generate with: openssl rand -hex 32
APP_SECRET=

# ─── Nightly snapshot (optional) ────────────────────────
# A dated, standalone snapshot is written to Blob every night regardless (see
# vercel.json), using the same BLOB_READ_WRITE_TOKEN above. With RESEND_API_KEY
# also set, a copy is emailed to ORDER_NOTIFY_EMAIL too — the one copy that
# lands somewhere other than this Vercel account, and the real protection
# against the account or project itself being lost. CRON_SECRET is required
# in production — without it the route refuses to run, so nobody can pull the
# catalogue by guessing the URL. Vercel sets this for you under Project
# Settings → Cron Jobs.
CRON_SECRET=
