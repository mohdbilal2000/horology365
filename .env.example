# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ─── Admin gate (Phase 1) ───────────────────────────────
# Shared password for /admin. If unset, a built-in default is used;
# change this in production via your Vercel project settings.
ADMIN_PASSWORD=showroom2026

# ─── Supabase (Phase 2) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Razorpay / UPI (Phase 2 — payments enabled later) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# UPI VPA shown at checkout for direct UPI-collect / QR (live now)
NEXT_PUBLIC_UPI_VPA=horology365@upi
NEXT_PUBLIC_UPI_PAYEE_NAME=Horology365

# ─── Payment mode ───────────────────────────────────────
# upi = UPI only (current). cod = Cash on Delivery. both = COD + UPI.
NEXT_PUBLIC_PAYMENT_MODE=upi

# ─── Analytics (env-gated) ──────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Email (Phase 2) ────────────────────────────────────
RESEND_API_KEY=
ORDER_FROM_EMAIL=orders@horology365.com
